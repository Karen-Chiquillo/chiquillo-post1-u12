<?xml version="1.0" encoding="UTF-8"?>
<!-- Mapeo JPA del dominio. Vive aqui y no en anotaciones para que dominio/ no importe jakarta.persistence -->
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
                 version="3.1">

    <entity class="com.empresa.reembolsos.dominio.SolicitudReembolso" access="FIELD">
        <table name="solicitudes_reembolso"/>
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
            <basic name="empleadoId" optional="false"/>
            <basic name="categoria" optional="false">
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="montoSolicitado" optional="false">
                <column precision="15" scale="2"/>
            </basic>
            <basic name="montoAprobado">
                <column precision="15" scale="2"/>
            </basic>
            <basic name="fechaGasto" optional="false"/>
            <basic name="estado" optional="false">
                <enumerated>STRING</enumerated>
            </basic>
        </attributes>
    </entity>
</entity-mappings>
